# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Next.js server (no se expone al navegador)
API_URL=http://localhost:3001/api

# PostgreSQL / Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=evidencefit

# JWT (genera un valor largo y aleatorio para desarrollo)
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_TIMEOUT_MS=60000

# Solo para `pnpm smoke:production`; no son variables de runtime de la app
SMOKE_API_URL=
SMOKE_EMAIL=
SMOKE_PASSWORD=
